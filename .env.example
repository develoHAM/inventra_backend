# ── App ──
NODE_ENV=development
PORT=3000

# ── Postgres (consumed by docker-compose AND the app) ──
POSTGRES_USER=inventra
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=inventra
POSTGRES_PORT=5432

# ── Redis (unused until caching phase, but wired now) ──
REDIS_PASSWORD=change_me_in_real_env
REDIS_PORT=6379

# ── Prisma / app DB connection ──
# Full literal string — must match POSTGRES_* above. Host-side, so localhost + POSTGRES_PORT.
DATABASE_URL=postgresql://inventra:change_me_in_real_env@localhost:5432/inventra?schema=public

# ── Auth (JWT) ──
# generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_64_char_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ── Seed (initial platform admin) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_in_real_env

# ── MinIO (S3) ──  (minioadmin defaults are fine for local dev; change in production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=inventra-files
S3_PRESIGN_EXPIRY_SECONDS=300